<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#331D212B"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="#33303642"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/surface_pressed"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/hairline"/></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/surface_elevated"/><corners android:radius="14dp"/><stroke android:width="1dp" android:color="@color/hairline"/></shape>
    </item>
</selector>
