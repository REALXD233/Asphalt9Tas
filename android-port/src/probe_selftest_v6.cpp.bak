// probe_selftest.cpp v6 — isolate the mprotect(+W) crash and test mprotect-free
// write paths for patching the read-only text page. Isolated process; the game
// process is never touched.
//
// Findings so far:
//  - Houdini mangles integer registers at naked-function entries (bl/br, any
//    prologue; d0/NZCV survive); compiled functions receive args correctly.
//    -> Design B (compiled probe) is required.
//  - mprotect(+W) on our own file-backed text page kills the process
//    (probeC crashed right after "trampoline mprotect(R) ok").
//  - Trampoline (anonymous) mprotect is fine.
//
// Modes:
//   plain    : compiled control (expect 325)
//   probeC   : Design B install using memcpy + mprotect(+W) (known crash — the
//              documented blocker, kept as control)
//   memfile  : same install, but the 16-byte patch is written via
//              /proc/self/mem (no mprotect at all)
//   ptrace   : same install, patch written via self PTRACE_POKEDATA
//   fresh    : mmap a clean copy of /proc/self/exe text (never-executed
//              file-backed page) and mprotect(+W) it — separates
//              "prior translations" vs "file-backed page" as the crash trigger
#include <atomic>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <fcntl.h>
#include <sys/mman.h>
#include <sys/ptrace.h>
#include <sys/types.h>
#include <sys/user.h>
#include <unistd.h>

extern "C" {
std::atomic<std::uint64_t> g_calls{0};
void* g_probe_trampoline = nullptr;
}

#define LOG(fmt, ...) \
    do { std::fprintf(stderr, "[selftest] " fmt "\n", ##__VA_ARGS__); } while (0)

// Compiled probe (Design B).
extern "C" __attribute__((noinline)) void ProbeFunc(void* context, const void* frame) {
    g_calls.fetch_add(1, std::memory_order_relaxed);
    using Fn = void (*)(void*, const void*);
    Fn trampoline = reinterpret_cast<Fn>(g_probe_trampoline);
    trampoline(context, frame);
}

void WriteAbsoluteJump(std::uint8_t* destination, std::uintptr_t target) {
    constexpr std::uint32_t load_x17_literal = 0x58000051;
    constexpr std::uint32_t branch_x17 = 0xD61F0220;
    std::memcpy(destination, &load_x17_literal, sizeof(load_x17_literal));
    std::memcpy(destination + 4, &branch_x17, sizeof(branch_x17));
    std::memcpy(destination + 8, &target, sizeof(target));
}

int MappingProtection(void* address) {
    FILE* maps = std::fopen("/proc/self/maps", "re");
    if (maps == nullptr) return 0;
    char line[2048]{};
    const auto target = reinterpret_cast<std::uintptr_t>(address);
    int protection = 0;
    while (std::fgets(line, sizeof(line), maps) != nullptr) {
        unsigned long long start = 0, end = 0;
        char perms[5]{};
        if (std::sscanf(line, "%llx-%llx %4s", &start, &end, perms) == 3 &&
            target >= start && target < end) {
            if (perms[0] == 'r') protection |= PROT_READ;
            if (perms[1] == 'w') protection |= PROT_WRITE;
            if (perms[2] == 'x') protection |= PROT_EXEC;
            break;
        }
    }
    std::fclose(maps);
    return protection;
}

// Write methods: returns true on success.
using WriteFn = bool (*)(std::uint8_t* dst, const std::uint8_t* src);

bool WriteMemcpy(std::uint8_t* dst, const std::uint8_t* src) {
    std::memcpy(dst, src, 16);
    return true;
}

bool WriteProcMem(std::uint8_t* dst, const std::uint8_t* src) {
    const int fd = open("/proc/self/mem", O_RDWR);
    if (fd < 0) {
        LOG("open /proc/self/mem failed errno=%d", errno);
        return false;
    }
    const ssize_t n = pwrite(fd, src, 16, reinterpret_cast<off_t>(dst));
    close(fd);
    LOG("proc/self/mem pwrite=%zd errno=%d", n, errno);
    return n == 16;
}

bool WritePtrace(std::uint8_t* dst, const std::uint8_t* src) {
    for (size_t done = 0; done < 16; done += sizeof(long)) {
        long word = 0;
        std::memcpy(&word, src + done, sizeof(word));
        if (ptrace(PTRACE_POKEDATA, getpid(),
                   reinterpret_cast<void*>(dst + done),
                   reinterpret_cast<void*>(word)) == -1) {
            LOG("PTRACE_POKEDATA failed at +%zu errno=%d", done, errno);
            return false;
        }
    }
    return true;
}

// Install with a pluggable write method. When use_mprotect is false, no page
// permission is changed (the write method must bypass it).
bool InstallProbe(std::uint8_t* target, WriteFn write16, bool use_mprotect) {
    std::uint8_t original_bytes[16]{};
    std::memcpy(original_bytes, target, sizeof(original_bytes));

    const long page_size = sysconf(_SC_PAGESIZE);
    if (page_size <= 0) return false;
    void* page = reinterpret_cast<void*>(
        reinterpret_cast<std::uintptr_t>(target) &
        ~static_cast<std::uintptr_t>(page_size - 1));
    const int original_protection = MappingProtection(page);
    if (original_protection == 0) {
        LOG("target page protection unknown; abort");
        return false;
    }
    LOG("target=%p page=%p original_prot=0x%x", target, page, original_protection);

    auto* trampoline = static_cast<std::uint8_t*>(
        mmap(nullptr, 32, PROT_READ | PROT_WRITE,
             MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
    if (trampoline == MAP_FAILED) {
        LOG("trampoline mmap failed");
        return false;
    }
    std::memcpy(trampoline, target, 16);
    WriteAbsoluteJump(trampoline + 16, reinterpret_cast<std::uintptr_t>(target + 16));
    __builtin___clear_cache(reinterpret_cast<char*>(trampoline),
                            reinterpret_cast<char*>(trampoline + 32));
    if (mprotect(trampoline, 32, PROT_READ) != 0) {
        LOG("trampoline mprotect(R) failed; keeping RW (errno=%d)", errno);
    } else {
        LOG("trampoline ready at %p", trampoline);
    }

    if (use_mprotect) {
        if (mprotect(page, static_cast<size_t>(page_size),
                     original_protection | PROT_WRITE) != 0) {
            munmap(trampoline, 32);
            LOG("target mprotect(+W) FAILED errno=%d; abort", errno);
            return false;
        }
        LOG("target mprotect(+W) ok");
    } else {
        LOG("no-mprotect mode: using pluggable write");
    }

    g_probe_trampoline = trampoline;
    std::uint8_t patch[16]{};
    WriteAbsoluteJump(patch, reinterpret_cast<std::uintptr_t>(&ProbeFunc));
    if (!write16(target, patch)) {
        LOG("patch write failed; abort");
        munmap(trampoline, 32);
        g_probe_trampoline = nullptr;
        return false;
    }
    __builtin___clear_cache(reinterpret_cast<char*>(target),
                            reinterpret_cast<char*>(target + 16));
    // read-back verification
    std::uint8_t back[16]{};
    std::memcpy(back, target, 16);
    LOG("readback %02x%02x%02x%02x %02x%02x%02x%02x ... (expect 51000058 20021fd6)",
        back[0], back[1], back[2], back[3], back[4], back[5], back[6], back[7]);

    if (use_mprotect) {
        if (mprotect(page, static_cast<size_t>(page_size), original_protection) != 0) {
            LOG("target mprotect restore FAILED errno=%d; rolling back", errno);
            mprotect(page, static_cast<size_t>(page_size),
                     original_protection | PROT_WRITE);
            std::memcpy(target, original_bytes, sizeof(original_bytes));
            __builtin___clear_cache(reinterpret_cast<char*>(target),
                                    reinterpret_cast<char*>(target + 16));
            mprotect(page, static_cast<size_t>(page_size), original_protection);
            munmap(trampoline, 32);
            g_probe_trampoline = nullptr;
            return false;
        }
        LOG("target mprotect restore ok");
    }
    LOG("probe installed");
    return true;
}

// Compiled control — also the Design B install target.
extern "C" __attribute__((noinline)) std::uint64_t PlainFunc(
    const std::uint64_t* pair, std::uint64_t frame, std::uint64_t a,
    std::uint64_t b, double c) {
    return pair[0] + pair[1] + frame + a + b + static_cast<std::uint64_t>(c);
}

static constexpr std::uint64_t kExpect = 325;

int main(int argc, char** argv) {
    const char* mode = argc > 1 ? argv[1] : "plain";
    std::uint64_t pair[2] = {100, 200};
    LOG("mode=%s pid=%d", mode, getpid());

    if (std::strcmp(mode, "plain") == 0) {
        const std::uint64_t r = PlainFunc(pair, 16, 2, 3, 4.0);
        LOG("plain result=%llu (expect %llu)", static_cast<unsigned long long>(r),
            static_cast<unsigned long long>(kExpect));
        return 0;
    }

    if (std::strcmp(mode, "probeC") == 0) {
        if (!InstallProbe(reinterpret_cast<std::uint8_t*>(&PlainFunc),
                          &WriteMemcpy, true)) {
            LOG("INSTALL FAILED");
            return 1;
        }
        const std::uint64_t r = PlainFunc(pair, 16, 2, 3, 4.0);
        LOG("probeC result=%llu calls=%llu (expect %llu 1)",
            static_cast<unsigned long long>(r),
            static_cast<unsigned long long>(g_calls.load()),
            static_cast<unsigned long long>(kExpect));
        return 0;
    }

    if (std::strcmp(mode, "memfile") == 0) {
        if (!InstallProbe(reinterpret_cast<std::uint8_t*>(&PlainFunc),
                          &WriteProcMem, false)) {
            LOG("INSTALL FAILED");
            return 1;
        }
        const std::uint64_t r = PlainFunc(pair, 16, 2, 3, 4.0);
        LOG("memfile result=%llu calls=%llu (expect %llu 1)",
            static_cast<unsigned long long>(r),
            static_cast<unsigned long long>(g_calls.load()),
            static_cast<unsigned long long>(kExpect));
        return 0;
    }

    if (std::strcmp(mode, "ptrace") == 0) {
        if (!InstallProbe(reinterpret_cast<std::uint8_t*>(&PlainFunc),
                          &WritePtrace, false)) {
            LOG("INSTALL FAILED");
            return 1;
        }
        const std::uint64_t r = PlainFunc(pair, 16, 2, 3, 4.0);
        LOG("ptrace result=%llu calls=%llu (expect %llu 1)",
            static_cast<unsigned long long>(r),
            static_cast<unsigned long long>(g_calls.load()),
            static_cast<unsigned long long>(kExpect));
        return 0;
    }

    if (std::strcmp(mode, "fresh") == 0) {
        // Clean file-backed page: mmap a fresh private copy of our own exe
        // text at a brand-new VA, mprotect(+W) it. No code from this VA was
        // ever executed (it is a new mapping).
        const int fd = open("/proc/self/exe", O_RDONLY);
        if (fd < 0) {
            LOG("open /proc/self/exe failed errno=%d", errno);
            return 1;
        }
        const long page_size = sysconf(_SC_PAGESIZE);
        auto* fresh = static_cast<std::uint8_t*>(
            mmap(nullptr, static_cast<size_t>(page_size), PROT_READ,
                 MAP_PRIVATE, fd, 0));
        if (fresh == MAP_FAILED) {
            LOG("fresh mmap failed errno=%d", errno);
            return 1;
        }
        LOG("fresh mapping at %p (never executed)", fresh);
        if (mprotect(fresh, static_cast<size_t>(page_size), PROT_READ | PROT_WRITE) != 0) {
            LOG("fresh mprotect(+W) FAILED errno=%d", errno);
        } else {
            LOG("fresh mprotect(+W) ok");
        }
        if (mprotect(fresh, static_cast<size_t>(page_size), PROT_READ) != 0) {
            LOG("fresh restore FAILED errno=%d", errno);
        } else {
            LOG("fresh restore ok");
        }
        munmap(fresh, static_cast<size_t>(page_size));
        close(fd);
        LOG("fresh done (survived)");
        return 0;
    }

    LOG("unknown mode %s", mode);
    return 2;
}
